[
  {
    "id": "F01",
    "note": "决断关口在负责人身上，九五居中拍板最合，下转大壮、砍后仍有气势。",
    "reviewed_end_king_wen": 34,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 43,
    "source": "A"
  },
  {
    "id": "F02",
    "note": "等待之局，九六等到最后、来者终吉，小畜言小有收获、仍需积累。",
    "reviewed_end_king_wen": 9,
    "reviewed_moving_lines": [
      6
    ],
    "reviewed_start_king_wen": 5,
    "source": "B"
  },
  {
    "id": "F03",
    "note": "合并重在公开结盟安人心，九四外比之贞吉，终萃人财汇聚。",
    "reviewed_end_king_wen": 45,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 8,
    "source": "B"
  },
  {
    "id": "F04",
    "note": "烂尾即积弊，初爻从最底层动手整治，终大畜积蓄再出发。",
    "reviewed_end_king_wen": 26,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 18,
    "source": "A"
  },
  {
    "id": "F05",
    "note": "两可，选三四爻因栋桡凶与栋隆吉正写硬扛与下调的两条路，终坎仍在险中求生。",
    "reviewed_end_king_wen": 29,
    "reviewed_moving_lines": [
      3,
      4
    ],
    "reviewed_start_king_wen": 28,
    "source": "baseline"
  },
  {
    "id": "F06",
    "note": "聚散关口在萃，初爻先摆诚意再谈条件，终随顺势而行。",
    "reviewed_end_king_wen": 17,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 45,
    "source": "A"
  },
  {
    "id": "F07",
    "note": "对方拖进度已成讼，九二先退一步、九五由高位裁断，终晋局面打开。",
    "reviewed_end_king_wen": 35,
    "reviewed_moving_lines": [
      2,
      5
    ],
    "reviewed_start_king_wen": 6,
    "source": "A"
  },
  {
    "id": "F08",
    "note": "推新工具即革，九三革言三就、有孚，讲清好处再推，终随团队跟上。",
    "reviewed_end_king_wen": 17,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 49,
    "source": "A"
  },
  {
    "id": "F09",
    "note": "选型错即积弊成蛊，初爻与三爻动手整治、小有悔无大咎，终损先舍后得。",
    "reviewed_end_king_wen": 41,
    "reviewed_moving_lines": [
      1,
      3
    ],
    "reviewed_start_king_wen": 18,
    "source": "baseline"
  },
  {
    "id": "F10",
    "note": "奖金不公在分寸，九四安节亨、标准公开各安其分，终兑坦诚皆大欢喜。",
    "reviewed_end_king_wen": 58,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 60,
    "source": "A"
  },
  {
    "id": "F11",
    "note": "老板all in是大壮过强，九四守正悔亡、强极守分寸，终泰通达。",
    "reviewed_end_king_wen": 11,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 34,
    "source": "A"
  },
  {
    "id": "F12",
    "note": "断供是坎险，九二求小得找替代、上六干等则凶，终观先看清局面。",
    "reviewed_end_king_wen": 20,
    "reviewed_moving_lines": [
      2,
      6
    ],
    "reviewed_start_king_wen": 29,
    "source": "A"
  },
  {
    "id": "F13",
    "note": "两人争吵已成讼，九四不克讼、复即命，各归本分，终涣争执散开重聚。",
    "reviewed_end_king_wen": 59,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 6,
    "source": "B"
  },
  {
    "id": "F14",
    "note": "创业路是屯开头难，初九磐桓利居贞、先想清能否扛住，终比靠人结盟。",
    "reviewed_end_king_wen": 8,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 3,
    "source": "A"
  },
  {
    "id": "F15",
    "note": "裁员即损，六三三人行则损一人、得其友，体面谈补偿出路，终大畜积蓄再出发。",
    "reviewed_end_king_wen": 26,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 41,
    "source": "A"
  },
  {
    "id": "F16",
    "note": "做不到要靠诚信，六四月几望、马匹亡无咎，实情讲清反得信任，终履谨慎前行。",
    "reviewed_end_king_wen": 10,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 61,
    "source": "A"
  },
  {
    "id": "F17",
    "note": "两deadline取舍在止，六五艮其辅、言有序，保一停一，终渐稳步推进。",
    "reviewed_end_king_wen": 53,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 52,
    "source": "A"
  },
  {
    "id": "F18",
    "note": "新人文化不合如旅，六二旅即次、靠身边人安顿摸清，终鼎立住新局面。",
    "reviewed_end_king_wen": 50,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 56,
    "source": "A"
  },
  {
    "id": "F19",
    "note": "连拿第一正盛在丰，九四丰其蔀、遇夷主吉，盛极主动收敛，终明夷韬光养晦。",
    "reviewed_end_king_wen": 36,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 55,
    "source": "A"
  },
  {
    "id": "F20",
    "note": "换供应商是价格账，九五有孚惠心、算长期价值勿问元吉，终颐滋养合作。",
    "reviewed_end_king_wen": 27,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 42,
    "source": "A"
  },
  {
    "id": "F21",
    "note": "合同未到期涨租已成讼，九二退一步、九四复即命摆合同依据，终观先看清再谈。",
    "reviewed_end_king_wen": 20,
    "reviewed_moving_lines": [
      2,
      4
    ],
    "reviewed_start_king_wen": 6,
    "source": "A"
  },
  {
    "id": "F22",
    "note": "股份两次谈不拢已成讼，六三食旧德、九四复即命回归合作本分，终巽柔顺再谈。",
    "reviewed_end_king_wen": 57,
    "reviewed_moving_lines": [
      3,
      4
    ],
    "reviewed_start_king_wen": 6,
    "source": "baseline"
  },
  {
    "id": "F23",
    "note": "超预算买房在节，九五甘节吉、守住底线别被喜欢冲昏头，终临机会仍在眼前。",
    "reviewed_end_king_wen": 19,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 60,
    "source": "A"
  },
  {
    "id": "F24",
    "note": "账上只够三月是困，初六臀困于株木、先稳住别贱卖，终兑坦诚沟通打开局面。",
    "reviewed_end_king_wen": 58,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 47,
    "source": "A"
  },
  {
    "id": "F25",
    "note": "账期僵持是小畜，九三舆说辐、夫妻反目，再僵关系要破，终中孚以诚重谈。",
    "reviewed_end_king_wen": 61,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 9,
    "source": "A"
  },
  {
    "id": "F26",
    "note": "竞业分歧先在核心团队内部达成一致，二爻主内，把条件补偿谈清楚。",
    "reviewed_end_king_wen": 9,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 37,
    "source": "A"
  },
  {
    "id": "F27",
    "note": "材料三退、寸步难行，三爻往蹇来反，宜找熟悉流程的人带路。",
    "reviewed_end_king_wen": 8,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 39,
    "source": "A"
  },
  {
    "id": "F28",
    "note": "财产分割僵持、双方已请律师成讼，三爻四爻由争转柔，宜先谈妥孩子再谈财产。",
    "reviewed_end_king_wen": 57,
    "reviewed_moving_lines": [
      3,
      4
    ],
    "reviewed_start_king_wen": 6,
    "source": "baseline"
  },
  {
    "id": "F29",
    "note": "流量确实大、收获在手，二爻五爻动而利共享，宜谈分成不买断。",
    "reviewed_end_king_wen": 13,
    "reviewed_moving_lines": [
      2,
      5
    ],
    "reviewed_start_king_wen": 14,
    "source": "B"
  },
  {
    "id": "F30",
    "note": "求三年长约锁定租金正是恒久之念，二爻悔亡，宜把长约对房东的好处算清楚。",
    "reviewed_end_king_wen": 62,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 32,
    "source": "A"
  },
  {
    "id": "F31",
    "note": "供货梗阻在中间，四爻噬乾胏得金矢，宜先催货保供、索赔后议。",
    "reviewed_end_king_wen": 27,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 21,
    "source": "A"
  },
  {
    "id": "F32",
    "note": "两边老板争当老大成讼，四爻不克讼、复即命，宜一方让步、重新凝聚再谈合并。",
    "reviewed_end_king_wen": 59,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 6,
    "source": "B"
  },
  {
    "id": "F33",
    "note": "押三付三困住现金流，四爻徐徐、五爻有说，宜有组织地谈判、以长合作换押一付三。",
    "reviewed_end_king_wen": 7,
    "reviewed_moving_lines": [
      4,
      5
    ],
    "reviewed_start_king_wen": 47,
    "source": "baseline"
  },
  {
    "id": "F34",
    "note": "补偿分歧已起争端，二爻退让不争、四爻复即命，宜据理和谈、静观其变。",
    "reviewed_end_king_wen": 20,
    "reviewed_moving_lines": [
      2,
      4
    ],
    "reviewed_start_king_wen": 6,
    "source": "baseline"
  },
  {
    "id": "F35",
    "note": "跨境在外、对方模板不利，四爻旅于处得资斧，宜一条一条抠条款、守住底线。",
    "reviewed_end_king_wen": 52,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 56,
    "source": "A"
  },
  {
    "id": "F36",
    "note": "独家结盟须对等，二爻比之自内，宜独家换销量对赌，签下仍须防销量落空之险。",
    "reviewed_end_king_wen": 29,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 8,
    "source": "A"
  },
  {
    "id": "F37",
    "note": "只剩一家被天天上门，初爻遁尾厉，宜别硬顶、把条件谈满意再体面退。",
    "reviewed_end_king_wen": 13,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 33,
    "source": "A"
  },
  {
    "id": "F38",
    "note": "冠名是面子、品牌是里子，二爻贲其须，宜冠名可谈、内容与底线守住。",
    "reviewed_end_king_wen": 26,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 22,
    "source": "A"
  },
  {
    "id": "F39",
    "note": "劳务纠纷想和解不想上法庭，二爻田获三狐，宜趁困局松动赶紧谈。",
    "reviewed_end_king_wen": 16,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 40,
    "source": "A"
  },
  {
    "id": "F40",
    "note": "对赌回购担子过重，五爻枯杨生华，宜把条款减到结构撑得住、可持续的水平。",
    "reviewed_end_king_wen": 32,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 28,
    "source": "A"
  },
  {
    "id": "F41",
    "note": "催婚之争在家有家规，初爻闲有家、悔亡，宜先立边界、再循序渐进谈婚事。",
    "reviewed_end_king_wen": 53,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 37,
    "source": "B"
  },
  {
    "id": "F42",
    "note": "友情以诚信为本，三爻或鼓或罢正合开口怕伤情、不开口难受之摇摆，先提小数目试探。",
    "reviewed_end_king_wen": 9,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 61,
    "source": "A"
  },
  {
    "id": "F43",
    "note": "夫妻志向相背、各执一端，三爻五爻动而由分歧转向坦诚，宜先谈各自怕什么再定去留。",
    "reviewed_end_king_wen": 1,
    "reviewed_moving_lines": [
      3,
      5
    ],
    "reviewed_start_king_wen": 38,
    "source": "baseline"
  },
  {
    "id": "F44",
    "note": "孩子沉迷游戏先问启蒙，二爻包蒙吉，宜先懂他在游戏里得到什么再谈管教。",
    "reviewed_end_king_wen": 23,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 4,
    "source": "A"
  },
  {
    "id": "F45",
    "note": "背后说坏话、光明受损，二爻明夷于左股，宜先保全自己、别正面硬碰。",
    "reviewed_end_king_wen": 11,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 36,
    "source": "A"
  },
  {
    "id": "F46",
    "note": "两代人带孩子分工不明，四爻富家大吉，宜划清谁负责谁说了算。",
    "reviewed_end_king_wen": 13,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 37,
    "source": "A"
  },
  {
    "id": "F47",
    "note": "两心相感、聊得投机，三爻咸其股，宜约出来见面、把关系从线上走到线下。",
    "reviewed_end_king_wen": 45,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 31,
    "source": "A"
  },
  {
    "id": "F48",
    "note": "老友合作公开为上，五爻同人先号咷后笑，宜钱的事先写清楚、亲兄弟明算账。",
    "reviewed_end_king_wen": 30,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 13,
    "source": "A"
  },
  {
    "id": "F49",
    "note": "两人上下不通、几乎无话，二爻包承、五爻休否，宜先约固定时间相处、慢慢打通。",
    "reviewed_end_king_wen": 64,
    "reviewed_moving_lines": [
      2,
      5
    ],
    "reviewed_start_king_wen": 12,
    "source": "baseline"
  },
  {
    "id": "F50",
    "note": "上门两次无果已成争端，五爻讼元吉，宜请物业居中裁断、别自己硬碰。",
    "reviewed_end_king_wen": 64,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 6,
    "source": "A"
  },
  {
    "id": "F51",
    "note": "聚会炫耀攀比，中心在比不在聚，以谦处之低调不跟比。",
    "reviewed_end_king_wen": 46,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 15,
    "source": "A"
  },
  {
    "id": "F52",
    "note": "父母住院，兄妹为钱与陪护争执，中心是家内分工未定，家人二爻各安其位先定分工。",
    "reviewed_end_king_wen": 9,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 37,
    "source": "B"
  },
  {
    "id": "F53",
    "note": "冷战非争讼，是无人先开口，兑二爻以诚开口，和好在沟通不在争理。",
    "reviewed_end_king_wen": 17,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 58,
    "source": "A"
  },
  {
    "id": "F54",
    "note": "功劳被抢、老板偏听，光明受损，宜留证韬光、待机再言，非当场争。",
    "reviewed_end_king_wen": 63,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 36,
    "source": "A"
  },
  {
    "id": "F55",
    "note": "学琴贵且不知能否坚持，中心在投入节奏，渐初爻一步步来，先短期试水。",
    "reviewed_end_king_wen": 37,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 53,
    "source": "A"
  },
  {
    "id": "F56",
    "note": "两可，选艮因无外险、只是内心未定，卖怕回不去、不卖空着，先止住想清房子对自己的意义再动。",
    "reviewed_end_king_wen": 18,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 52,
    "source": "A"
  },
  {
    "id": "F57",
    "note": "看人晒比心烦，中心在自己的看与心境，观二爻看清别被带跑，屏蔽是小事。",
    "reviewed_end_king_wen": 59,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 20,
    "source": "A"
  },
  {
    "id": "F58",
    "note": "养狗分歧在时间与照顾之责，颐二爻先算清谁来养，讲好分工再决定。",
    "reviewed_end_king_wen": 41,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 27,
    "source": "A"
  },
  {
    "id": "F59",
    "note": "多年不联系突然借钱，中心在不期而遇与防备，姤初爻先刹住、四爻见其所求未必有实，宜观望不贸然借。",
    "reviewed_end_king_wen": 9,
    "reviewed_moving_lines": [
      1,
      4
    ],
    "reviewed_start_king_wen": 44,
    "source": "baseline"
  },
  {
    "id": "F60",
    "note": "父母长住住不下、租房怕老人多心，中心是家内安置与体面，家人上爻以威如待之、终吉。",
    "reviewed_end_king_wen": 63,
    "reviewed_moving_lines": [
      6
    ],
    "reviewed_start_king_wen": 37,
    "source": "B"
  },
  {
    "id": "F61",
    "note": "主角动机圆不上是故事根上的积弊，蛊初爻从根改、五爻改到底，小有积蓄再续写。",
    "reviewed_end_king_wen": 9,
    "reviewed_moving_lines": [
      1,
      5
    ],
    "reviewed_start_king_wen": 18,
    "source": "A"
  },
  {
    "id": "F62",
    "note": "用心做却无流量，中心在风格与热点的张力，巽三爻频巽为吝——可借风渗透，不可丢了风格去追热点。",
    "reviewed_end_king_wen": 59,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 57,
    "source": "A"
  },
  {
    "id": "F63",
    "note": "客户说“大气”却说不清，中心在需求模糊，观四爻先看清、多给方向让客户选，别猜。",
    "reviewed_end_king_wen": 12,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 20,
    "source": "A"
  },
  {
    "id": "F64",
    "note": "吉他要重、主唱要流行，中心在看法背离，睽二爻巷中相遇、五爻与同宗和解，先找一首两边都接受的歌。",
    "reviewed_end_king_wen": 25,
    "reviewed_moving_lines": [
      2,
      5
    ],
    "reviewed_start_king_wen": 38,
    "source": "baseline"
  },
  {
    "id": "F65",
    "note": "第一期录三遍仍不满，中心在开头难与求全，屯三爻舍却求全之追、四爻往吉，先发出来再改。",
    "reviewed_end_king_wen": 49,
    "reviewed_moving_lines": [
      3,
      4
    ],
    "reviewed_start_king_wen": 3,
    "source": "baseline"
  },
  {
    "id": "F66",
    "note": "画自满意却无人懂，中心在外表与内容未相得，贲三爻去饰、上爻白贲归真，回归本心再出发。",
    "reviewed_end_king_wen": 24,
    "reviewed_moving_lines": [
      3,
      6
    ],
    "reviewed_start_king_wen": 22,
    "source": "baseline"
  },
  {
    "id": "F67",
    "note": "无人做过的产品、市场未知，中心在开创而非等待，乾初二爻先以最小版本现身试水，机会与同伴在路上。",
    "reviewed_end_king_wen": 33,
    "reviewed_moving_lines": [
      1,
      2
    ],
    "reviewed_start_king_wen": 1,
    "source": "A"
  },
  {
    "id": "F68",
    "note": "副歌三天落不下来，中心在硬写不动，蹇四爻往蹇来连、五爻大蹇朋来，先停下换角度、找人帮耳。",
    "reviewed_end_king_wen": 62,
    "reviewed_moving_lines": [
      4,
      5
    ],
    "reviewed_start_king_wen": 39,
    "source": "baseline"
  },
  {
    "id": "F69",
    "note": "主角反悔、前期投入白费，中心在被困于已付出的沉没成本，困三爻困于石与蒺藜，须找中间人再谈、谈不拢就换主角。",
    "reviewed_end_king_wen": 28,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 47,
    "source": "A"
  },
  {
    "id": "F70",
    "note": "玩法新但玩家看不懂规则，中心在启蒙未通，蒙二爻包蒙纳言、四爻困蒙点出卡点，从玩家困惑里改规则。",
    "reviewed_end_king_wen": 35,
    "reviewed_moving_lines": [
      2,
      4
    ],
    "reviewed_start_king_wen": 4,
    "source": "baseline"
  },
  {
    "id": "F71",
    "note": "投资人要加流量明星、角色不合，中心在装饰与内容之争，贲五爻小束帛可纳，角色与故事不为明星让路。",
    "reviewed_end_king_wen": 37,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 22,
    "source": "A"
  },
  {
    "id": "F72",
    "note": "场地被让给别人，中心在失而复起，复二爻休复，作品在、换个地方展览就能重新开始。",
    "reviewed_end_king_wen": 19,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 24,
    "source": "A"
  },
  {
    "id": "F73",
    "note": "两可，选小畜因小作坊规模未及、须以价牵回复归分寸；大过亦像过载，但其爻辞不落“涨价或找人”的取舍。",
    "reviewed_end_king_wen": 37,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 9,
    "source": "A"
  },
  {
    "id": "F74",
    "note": "追热点涨粉快却心累，中心在节奏失度，节三爻不节则嗟，定一周最多一次的度，余下写自己想写的。",
    "reviewed_end_king_wen": 5,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 60,
    "source": "A"
  },
  {
    "id": "F75",
    "note": "音乐版权被撤、编舞半途，中心在旧条件已变须革，革二爻巳日乃革，换个思路顺着新音乐编。",
    "reviewed_end_king_wen": 43,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 49,
    "source": "A"
  },
  {
    "id": "F76",
    "note": "对方未回只是时机未到；二爻需于沙小有言终吉，先把内容做好再约更有底气。",
    "reviewed_end_king_wen": 63,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 5,
    "source": "A"
  },
  {
    "id": "F77",
    "note": "写崩的是感情线本身，核心是两心相感是否真诚；五爻咸其脢，须从人物真实动机重长感情线。",
    "reviewed_end_king_wen": 62,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 31,
    "source": "A"
  },
  {
    "id": "F78",
    "note": "三版不满意又没时间，核心是中间梗阻须下决心啃掉；二爻噬肤灭鼻，定deadline选最接近的一版。",
    "reviewed_end_king_wen": 38,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 21,
    "source": "A"
  },
  {
    "id": "F79",
    "note": "两可，选贲因剪辑属装饰、困在内容空洞而非心情松快；三四爻由饰转实，须啃掉内容梗阻再定重剪或换题材。",
    "reviewed_end_king_wen": 21,
    "reviewed_moving_lines": [
      3,
      4
    ],
    "reviewed_start_king_wen": 22,
    "source": "baseline"
  },
  {
    "id": "F80",
    "note": "三次被退且反馈含糊，核心是言路不通的困而非当止则止；四爻徐徐、五爻徐有说，宜主动求教而非空等。",
    "reviewed_end_king_wen": 7,
    "reviewed_moving_lines": [
      4,
      5
    ],
    "reviewed_start_king_wen": 47,
    "source": "baseline"
  },
  {
    "id": "F81",
    "note": "身体已抗议，核心是靠什么养自己而非单纯等时机；颐三爻拂颐、五爻拂经居贞，先养根本再谈事。",
    "reviewed_end_king_wen": 37,
    "reviewed_moving_lines": [
      3,
      5
    ],
    "reviewed_start_king_wen": 27,
    "source": "A"
  },
  {
    "id": "F82",
    "note": "两月体重不动，核心是节奏与恒定出了问题；三爻不恒其德，须先查方法对不对再谈坚持。",
    "reviewed_end_king_wen": 40,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 32,
    "source": "A"
  },
  {
    "id": "F83",
    "note": "三年机子电池衰，核心是花小钱续命还是花大钱换新；损二爻利贞，先舍后得算清账。",
    "reviewed_end_king_wen": 27,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 41,
    "source": "A"
  },
  {
    "id": "F84",
    "note": "家事做不完与想出门相持，核心是该停就停；四爻艮其身无咎，停半天透气回来再做。",
    "reviewed_end_king_wen": 56,
    "reviewed_moving_lines": [
      4
    ],
    "reviewed_start_king_wen": 52,
    "source": "A"
  },
  {
    "id": "F85",
    "note": "核心是分寸而非等待；二爻不出户庭，留够应急的钱，剩下的再还房贷。",
    "reviewed_end_king_wen": 3,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 60,
    "source": "A"
  },
  {
    "id": "F86",
    "note": "发烧是险中求生的判断题；三爻来之坎坎勿用，先看精神状态定去留。",
    "reviewed_end_king_wen": 48,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 29,
    "source": "A"
  },
  {
    "id": "F87",
    "note": "漏水是积弊越拖越贵；二爻从基层动手、四爻忌宽纵不彻底，整治到底。",
    "reviewed_end_king_wen": 56,
    "reviewed_moving_lines": [
      2,
      4
    ],
    "reviewed_start_king_wen": 18,
    "source": "A"
  },
  {
    "id": "F88",
    "note": "两小时通勤是在外漂泊，核心是算清换工作与搬家各自代价；五爻射雉终以誉命，选其一付代价。",
    "reviewed_end_king_wen": 33,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 56,
    "source": "A"
  },
  {
    "id": "F89",
    "note": "报了课去不了，核心是步子与节奏不对；三爻鸿渐于陆，先每周固定一小时再加量。",
    "reviewed_end_king_wen": 20,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 53,
    "source": "A"
  },
  {
    "id": "F90",
    "note": "旧物堆满舍不得扔，核心是先舍后得；五爻或益之元吉，先扔一年没用过的。",
    "reviewed_end_king_wen": 61,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 41,
    "source": "A"
  },
  {
    "id": "F91",
    "note": "指标偏高应酬难推，核心是靠什么养自己；五爻拂经居贞吉，守中少吃多动。",
    "reviewed_end_king_wen": 42,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 27,
    "source": "A"
  },
  {
    "id": "F92",
    "note": "堵死不动是蹇；二爻王臣蹇蹇匪躬之故，别死等，找导航小路绕行。",
    "reviewed_end_king_wen": 48,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 39,
    "source": "A"
  },
  {
    "id": "F93",
    "note": "贵怕心疼、便宜怕不够好，核心是谦逊合心意而非价钱；三爻劳谦有终吉，礼物让父母安心最重要。",
    "reviewed_end_king_wen": 2,
    "reviewed_moving_lines": [
      3
    ],
    "reviewed_start_king_wen": 15,
    "source": "A"
  },
  {
    "id": "F94",
    "note": "刷到半夜戒不掉，核心是止；初爻艮其趾无咎利永贞，先定睡前一小时不碰手机。",
    "reviewed_end_king_wen": 22,
    "reviewed_moving_lines": [
      1
    ],
    "reviewed_start_king_wen": 52,
    "source": "A"
  },
  {
    "id": "F95",
    "note": "疑被缺斤少两未成争执，核心是诚信相孚；二爻鸣鹤在阴其子和之，先客气提一次再换摊。",
    "reviewed_end_king_wen": 42,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 61,
    "source": "A"
  },
  {
    "id": "F96",
    "note": "暖气未到冷得睡不着，核心是等而有备；五爻需于酒食贞吉，先买小的顶几天。",
    "reviewed_end_king_wen": 11,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 5,
    "source": "A"
  },
  {
    "id": "F97",
    "note": "听朋友荐股是妄动，核心是按本分不妄动；初爻无妄往吉、三爻无妄之灾，先想清能否承受再定。",
    "reviewed_end_king_wen": 33,
    "reviewed_moving_lines": [
      1,
      3
    ],
    "reviewed_start_king_wen": 25,
    "source": "A"
  },
  {
    "id": "F98",
    "note": "换几盆还是死，核心是根基与滋养出了问题；二爻井谷射鲋瓮敝漏，先查水多还是光少。",
    "reviewed_end_king_wen": 39,
    "reviewed_moving_lines": [
      2
    ],
    "reviewed_start_king_wen": 48,
    "source": "A"
  },
  {
    "id": "F99",
    "note": "每次跑两天就放弃，核心是恒定与节奏；五爻恒其德须因人制宜，别定五公里先定十分钟。",
    "reviewed_end_king_wen": 28,
    "reviewed_moving_lines": [
      5
    ],
    "reviewed_start_king_wen": 32,
    "source": "A"
  },
  {
    "id": "F100",
    "note": "定高怕完不成、定低没劲，核心是蓄势待发；二爻舆说輹、六爻何天之衢，目标定在踮脚够得着处。",
    "reviewed_end_king_wen": 36,
    "reviewed_moving_lines": [
      2,
      6
    ],
    "reviewed_start_king_wen": 26,
    "source": "A"
  }
]